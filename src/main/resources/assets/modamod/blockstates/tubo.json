{
  "multipart": [
    {
      "when": {
        "extremo_north": "abierto|tapa|boca"
      },
      "apply": {
        "model": "modamod:block/tubo_brazo_north"
      }
    },
    {
      "when": {
        "extremo_north": "sin"
      },
      "apply": {
        "model": "modamod:block/tubo_nucleo_north"
      }
    },
    {
      "when": {
        "extremo_north": "tapa"
      },
      "apply": {
        "model": "modamod:block/tubo_tapa_north"
      }
    },
    {
      "when": {
        "extremo_north": "boca"
      },
      "apply": {
        "model": "modamod:block/tubo_boca_north"
      }
    },
    {
      "when": {
        "AND": [
          {
            "agua": "true"
          },
          {
            "extremo_north": "abierto|tapa|boca"
          }
        ]
      },
      "apply": {
        "model": "modamod:block/tubo_agua_north"
      }
    },
    {
